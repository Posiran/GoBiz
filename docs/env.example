# Gobiz — کلیدهای .env مخصوص این پروژه. روی .env.example خودِ لاراول اضافه کنید.
# مقدارهای خالی را خودتان پر کنید. این فایل را با رمزهای واقعی commit نکنید.

APP_NAME=Gobiz
APP_URL=https://gobiz.ir
APP_TIMEZONE=Asia/Tehran     # توصیه می‌شود؛ تاریخ‌های شمسی در هر حال به وقت تهران نمایش داده می‌شوند
APP_LOCALE=fa
DB_CONNECTION=mysql               # اسکیما MySQL 8 است (fullText و ENUM)
# CACHE_STORE=database           # sitemap و withoutOverlapping از cache استفاده می‌کنند

# --- پیامک (IPPanel Edge API) (ippanel.php) ---
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_TOKEN=
IPPANEL_FROM=
IPPANEL_PATTERN_OTP=
IPPANEL_PATTERN_INQUIRY=
IPPANEL_PATTERN_OFFER=
IPPANEL_PATTERN_ACCESS=
IPPANEL_PATTERN_ORDER=

# --- پلن و درگاه‌های پرداخت (payment.php) ---
FREE_LISTINGS=3
PAYMENT_ENABLED=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
BEHPARDAKHT_TERMINAL_ID=
BEHPARDAKHT_USERNAME=
BEHPARDAKHT_PASSWORD=
BEHPARDAKHT_WSDL=https://bpm.shaparak.ir/pgwchannel/services/pgw?wsdl
BEHPARDAKHT_START_URL=https://bpm.shaparak.ir/pgwchannel/startpay.mellat
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_KEY=
SADAD_BASE_URL=https://sadad.shaparak.ir/vpg/api/v0
SADAD_PURCHASE_URL=https://sadad.shaparak.ir/VPG/Purchase

# --- استقرار خودکار (gobiz.php) — در shared/.env هر محیط روی هاست ---
ADMIN_MOBILE=                     # اولین مدیر سایت (فقط اگر هنوز مدیری نیست)
STAGING_USER=gobiz                # فقط نسخه تست
STAGING_PASSWORD=                 # فقط نسخه تست: رمز HTTP و جلوگیری از ایندکس؛ در سایت اصلی خالی بماند
SMS_ONLY_TO=                      # فقط نسخه تست: شماره‌های مجاز برای پیامک واقعی (جدا با کاما)
DEMO_DATA=false                   # فقط نسخه تست: داده نمایشی
